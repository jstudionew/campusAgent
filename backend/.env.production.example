# ==========================================================
# SMS Backend - Production Environment Variables Example
# (DO NOT COMMIT YOUR REAL SECRETS TO GIT)
# ==========================================================

# Server Environment
NODE_ENV=production
PORT=10000

# Database Connection (Neon / Supabase / Render Postgres)
# Replace with your actual Neon/Supabase connection string with sslmode=require
DATABASE_URL=postgres://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
SMS_AUTO_CREATE_DB=false
PGSSL=true

# Security: Set strong, unpredictable secrets (e.g. generated via `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_super_strong_random_jwt_secret_min_32_chars
REFRESH_SECRET=replace_with_a_super_strong_random_refresh_secret_min_32_chars

# CORS: Set your Netlify frontend URL (comma-separated if multiple)
CORS_ORIGINS=https://campusagent2.netlify.app

# Initial Owner Account (used when bootstrapping a new owner)
OWNER_EMAIL=officialid40@gmail.com
OWNER_USERNAME=jstudio
OWNER_PASSWORD=123654
OWNER_NAME="Jstudio"
# Set true temporarily to sync OWNER_* into an existing owner; turn off afterward
OWNER_SYNC_ON_BOOT=false
