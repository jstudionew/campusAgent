# ==========================================================
# SMS Frontend - Production Environment Variables Example
# (Set these in the Netlify Dashboard under Site Configuration > Environment Variables)
# ==========================================================

# Base URL for the Express API on Render / Railway
VITE_API_URL=https://your-school-backend.onrender.com

# Web Base Path (must be / for web hosting to prevent 404s on subpaths)
VITE_BASE_URL=/

# Storage and Session Settings
VITE_TOKEN_STORAGE=local
VITE_ENABLE_DEMO_AUTH=false
VITE_REQUEST_TIMEOUT_MS=15000
